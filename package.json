    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lunar-javascript": "^1.7.7",
    "moment-timezone": "^0.6.2",
    "node-cron": "^4.5.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  },
  "license": "ISC"
}
