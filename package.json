{
  "name": "qigong-whatsapp-bot",
  "version": "0.1.0",
  "description": "WhatsApp Business Platform version of the Qigong check-in companion.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r public dist/",
